    "NSAppleEventsUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kairos controls other apps only when applying an app-control network scene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kairos 仅在应用控制网络场景生效时控制其他应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kairos 僅在 App 控制網路場景生效時控制其他 App。"
          }
        }
      }
    }
  },
  "version" : "1.0"
