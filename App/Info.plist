<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KairosUpdateChannel</key>
	<string>$(KAIROS_UPDATE_CHANNEL)</string>
	<key>KairosUpdaterEnabled</key>
	<string>$(KAIROS_UPDATER_ENABLED)</string>
	<key>LSUIElement</key>
	<true/>
